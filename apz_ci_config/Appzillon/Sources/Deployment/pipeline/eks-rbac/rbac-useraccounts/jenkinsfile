def values=[]
node {
    values = params["RBAC_ROLES"].split(",")
}
pipeline {
    parameters {
      string defaultValue: 'dev-eks', description: '', name: 'CLUSTER_NAME', trim: false
      string defaultValue: 'us-east-1', description: '', name: 'CLUSTER_REGION', trim: false
      string defaultValue: '169639270777', description: '', name: 'AWS_ACCOUNT_ID', trim: false
      string defaultValue: 'develop', description: '', name: 'BRANCH', trim: false
      string defaultValue: '', description: '', name: 'AWS_USERNAME', trim: false
      string defaultValue: 'kubernetes-dashboard', description: '', name: 'NAMESPACE', trim: false
      extendedChoice defaultValue: '', description: 'Choose any of the below options to enable rbac roles', multiSelectDelimiter: ',', name: 'RBAC_ROLES', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_CHECKBOX', value: 'CLUSTER_ADMIN_USER,LOCAL_ADMIN_USER,DEVELOPER_USER', visibleItemCount: 3
      string defaultValue: 'ubuntu', description: '', name: 'SHIPPER_USERNAME', trim: false
      string defaultValue: '44.198.111.227', description: '', name: 'SHIPPER_TARGET', trim: false
 }
agent any
    stages {
        stage('RBAC'){
            steps{
                sshagent (credentials: ['run-eks-client']) {
                    script{
                        sh '''
                        COMMAND0="aws eks update-kubeconfig --name ${CLUSTER_NAME}  --region ${CLUSTER_REGION}"
                        ssh -o StrictHostKeyChecking=no -l ${SHIPPER_USERNAME} ${SHIPPER_TARGET} $COMMAND0
                        
                        SOURCE_PATH=$WORKSPACE/eks-rbac/rbac-useraccounts/rbac-user
                        DESTINATION_PATH=/home/${SHIPPER_USERNAME}/projects/ship-eks/${BRANCH}/
                        scp -o StrictHostKeyChecking=no -r $SOURCE_PATH ${SHIPPER_USERNAME}@${SHIPPER_TARGET}:$DESTINATION_PATH
                        '''
                        CLUSTER_ADMIN_USER= "${ 'CLUSTER_ADMIN_USER' in values ? 'true' : 'false'}"
                        LOCAL_ADMIN_USER= "${ 'LOCAL_ADMIN_USER' in values ? 'true' : 'false'}"
                        DEVELOPER_USER= "${ 'DEVELOPER_USER' in values ? 'true' : 'false'}"

                        DESTINATION_PATH="/home/"+SHIPPER_USERNAME+"/projects/ship-eks/"+BRANCH
                        sh "ssh -o StrictHostKeyChecking=no -l ${SHIPPER_USERNAME} ${SHIPPER_TARGET} 'helm upgrade  --install rbac-user ${DESTINATION_PATH}/rbac-user --set userName=${AWS_USERNAME} --set rbac.localAdmin=${LOCAL_ADMIN_USER} --set rbac.clusterAdmin=${CLUSTER_ADMIN_USER} --set rbac.developer=${DEVELOPER_USER} --set nameSpace=${NAMESPACE} -n ${NAMESPACE}'"
                    }    
                }
            }   
        }
    }
    post { 
        always { 
            cleanWs()
        }
    }
}