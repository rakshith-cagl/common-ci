def values=[]
node {
    values = params["DEPLOY_TYPES"].split(",")
}

pipeline {
   parameters{
      string defaultValue: 'dev-eks', description: '', name: 'CLUSTER_NAME', trim: false
      string defaultValue: 'us-east-1', description: '', name: 'CLUSTER_REGION', trim: false
      extendedChoice defaultValue: '', description: 'Choose any of the below options to clean up the deployments', multiSelectDelimiter: ',', name: 'DEPLOY_TYPES', quoteValue: false, saveJSONParameterToFile: false, type: 'PT_CHECKBOX', value: 'web,server,fluentd-cloudwatch,rbac-serviceaccounts,rbac-user,fluentbit,eks-dashboard,prometheus,grafana', visibleItemCount: 9
