<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.iexceed.plugins.autocapturedocument.FrameGraphicOverlay
        android:id="@+id/frame_preview_graphic_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.iexceed.plugins.autocapturedocument.GraphicOverlay
        android:id="@+id/camera_preview_graphic_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        />


    <FrameLayout
        android:id="@+id/static_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
           >
            <ToggleButton
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:id="@+id/captureMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textOn="Auto"
                android:textOff="Manual"
                android:checked="false"
                android:textAllCaps="false"
                android:background="@drawable/toggle_bg"
                />

            <TextView
                android:id="@+id/pagetitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text=""
                android:textColor="@color/white"
                android:textSize="23sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/search_progress_bar"
            android:layout_width="@dimen/search_progress_bar_size"
            android:layout_height="@dimen/search_progress_bar_size"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/white"
            android:indeterminateTintMode="src_in"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/edge_frame"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_gravity="center"
            android:background="@drawable/edge_frame"
            >

        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/msgTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:textColor="@color/white"
                android:textSize="23sp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>
            <TextView
                android:id="@+id/messages"
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:layout_marginBottom="10dp"
                android:textColor="@color/white"
                android:textSize="19sp" />
            <TextView
                android:id="@+id/scanningTextMsg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text=""
                android:layout_marginTop="5dp"
                android:textColor="@color/white"
                android:textSize="18sp" />
            <ImageButton
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:id="@+id/captureButton"
                android:onClick="takePicture"
                android:layout_marginTop="10dp"
                android:layout_gravity="bottom|center"
                android:scaleType="fitXY"
                android:visibility="gone"
                android:background="@drawable/lens"
                />
        </LinearLayout>

    </FrameLayout>

