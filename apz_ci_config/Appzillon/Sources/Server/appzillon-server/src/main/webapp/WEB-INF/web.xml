<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >
<web-app>
	<display-name>Appzillon Internal Server</display-name>
	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>
			classpath:APPZILLONSERVERPROPSCNTX/META-INF/spring/camel-context.xml
            classpath:APPZILLONSERVERPROPSCNTX/META-INF/spring/DOMAIN-Spring.xml
		</param-value>
	</context-param>
	<context-param>
		<param-name>contextAppId</param-name>
		<param-value>CTXAPPID</param-value>
	</context-param>
	<context-param>
		<param-name>cloudProvider</param-name>
		<param-value>CTXCLOUDPROVIDER</param-value>
	</context-param>
	<context-param>
		<param-name>logbackDisableServletContainerInitializer</param-name>
		<param-value>true</param-value>
	</context-param>
	<listener>
		<listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
	</listener>
	<listener>
		<listener-class>com.iexceed.appzillon.startup.AppzillonRestWSStartup</listener-class>
	</listener>
	<listener>
		<listener-class>org.springframework.web.context.request.RequestContextListener</listener-class>
	</listener>
	<servlet>
		<servlet-name>jersey</servlet-name>
		<servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
		<init-param>
			<param-name>javax.ws.rs.Application</param-name>
			<param-value>com.iexceed.appzillon.rest.ConfigRegister</param-value>
		</init-param>
		<init-param>
			<param-name>jersey.config.server.provider.classnames</param-name>
			<param-value>org.glassfish.jersey.media.multipart.MultiPartFeature;com.iexceed.appzillonbanking.custom.service.impl.CreateUserServices</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet>
		<servlet-name>status</servlet-name>
		<jsp-file>/index.jsp</jsp-file>
	</servlet>
	<servlet>
		<servlet-name>USSDServlet</servlet-name>
		<servlet-class>com.iexceed.appzillon.rest.USSDServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>jersey</servlet-name>
		<url-pattern>/*</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>status</servlet-name>
		<url-pattern>/status</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>USSDServlet</servlet-name>
		<url-pattern>/USSDServlet</url-pattern>
	</servlet-mapping>
	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

	<security-constraint>
		<web-resource-collection>
			<web-resource-name>restricted methods</web-resource-name>
			<url-pattern>/APPZILLONSERVERCNTX/Appzillon</url-pattern>
			<http-method>GET</http-method>
			<http-method>PUT</http-method>
			<http-method>HEAD</http-method>
			<http-method>DELETE</http-method>
			<http-method>OPTIONS</http-method>
			<http-method>TRACE</http-method>
		</web-resource-collection>
		<web-resource-collection>
			<web-resource-name>Upload Files</web-resource-name>
			<url-pattern>/APPZILLONSERVERCNTX/upload</url-pattern>
			<http-method>GET</http-method>
			<http-method>PUT</http-method>
			<http-method>HEAD</http-method>
			<http-method>DELETE</http-method>
			<http-method>OPTIONS</http-method>
			<http-method>TRACE</http-method>
		</web-resource-collection>
		<web-resource-collection>
			<web-resource-name>SMS In</web-resource-name>
			<url-pattern>/APPZILLONSERVERCNTX/Appzillon/SMSIn</url-pattern>
			<http-method>PUT</http-method>
			<http-method>HEAD</http-method>
			<http-method>DELETE</http-method>
			<http-method>OPTIONS</http-method>
			<http-method>TRACE</http-method>
		</web-resource-collection>
		<web-resource-collection>
			<web-resource-name>Health</web-resource-name>
			<url-pattern>/APPZILLONSERVERCNTX/Appzillon/health</url-pattern>
			<http-method>POST</http-method>
			<http-method>PUT</http-method>
			<http-method>HEAD</http-method>
			<http-method>DELETE</http-method>
			<http-method>OPTIONS</http-method>
			<http-method>TRACE</http-method>
		</web-resource-collection>
		<web-resource-collection>
			<web-resource-name>Reload</web-resource-name>
			<url-pattern>/APPZILLONSERVERCNTX/Appzillon/reload</url-pattern>
			<http-method>POST</http-method>
			<http-method>PUT</http-method>
			<http-method>HEAD</http-method>
			<http-method>DELETE</http-method>
			<http-method>OPTIONS</http-method>
			<http-method>TRACE</http-method>
		</web-resource-collection>
		<auth-constraint />
	</security-constraint>
</web-app>
