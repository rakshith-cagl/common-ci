<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Stop output INFO at start -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
    <appender name="aiAppender"
              class="com.microsoft.applicationinsights.logback.ApplicationInsightsAppender">
        <instrumentationKey>${sys:INSTRUMENTATION_KEY}</instrumentationKey>
        <JSONLayout complete="false" compact="false" properties="true" includeStacktrace="true">
        </JSONLayout>
    </appender>
    <Logger additivity="false" level="OFF" name="org.springframework">
        <AppenderRef level="OFF" ref="aiAppender"/>
    </Logger>
    <Logger additivity="false" level="OFF" name="org.hibernate">
        <AppenderRef level="OFF" ref="aiAppender"/>
    </Logger>
    <Logger additivity="false" level="OFF" name="org.jboss">
        <AppenderRef level="OFF" ref="aiAppender"/>
    </Logger>
    <Logger additivity="false" level="OFF" name="org.apache">
        <AppenderRef level="OFF" ref="aiAppender"/>
    </Logger>

    <Logger name="com.iexceed.webcontainer" level="APPZILLONLOGGINGLEVEL">
        <AppenderRef ref="ASYNC" level="APPZILLONLOGGINGLEVEL" />
    </Logger>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="aiAppender" />
    </appender>

    <root level="APPZILLONLOGGINGLEVEL">
        <appender-ref ref="aiAppender" />
    </root>

</configuration>