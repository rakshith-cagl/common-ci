template.MaintenanceSummary.createLayout = function() {
    template.addBody(null, 'BODY');
    template.addRow('SearchRow', 'BODY', null, 'GRIDROW');
    template.addColumn('SearchGridCol', 'SearchRow', null, 'GRIDCOL');
    template.addPanel('headerPanel', 'SearchGridCol', 'SIMPLE', null, 'SIMPLEPANEL');
    template.addPanelSection("headerPanelSection", "headerPanel", null, "PANELSECTION");
    template.addContainer("headerNavbar", "headerPanelSection", "NAVBAR", null, "NAVBAR");
    template.addRow("headerNavbarSecRow", "headerNavbar", null, "SECTIONROW");
    template.addColumn("headerStaticTextSecCol", "headerNavbarSecRow", null, "SECTIONCOL");
    template.addElement("headerText", "headerStaticTextSecCol", "TEXT", null, "TEXT");
    if (datamodel.name != undefined) {
        main.pointers["headerText"].defaultvalue = datamodel.name.toUpperCase();
        main.pointers["headerText"].elementtype = "HEADING4";
    }
   
    main.pointers['headerNavbar'].appearance = 'ter';
    
    // Creating FORM
    lcolrequired = true;
	lcount = 0;
	var lservicetyp = "";
	var lnoofifaces = datamodel.interfaces.length;

	template.addPanel('formPanel', 'SearchGridCol', 'SIMPLE', null, 'SIMPLEPANEL');
    template.addPanelSection("formPanelSection", "formPanel", null, "PANELSECTION");
    template.addContainer('FORM1', 'formPanelSection', 'FORM', null, 'FORM');
    template.addRow('formSecRow', 'FORM1', null, "SECTIONROW");
    main.pointers["FORM1"].orientation = 'VERTICAL';

    // Creating Buttons
    template.addPanel('btnPanel', 'SearchGridCol', 'SIMPLE', null, 'SIMPLEPANEL');
    template.addPanelSection("btnPanelSection", "btnPanel", null, "PANELSECTION");
    template.addContainer("btnNavbar", "btnPanelSection", "NAVBAR", null, "NAVBAR");
    template.addRow('btnSecRow', 'btnNavbar', null, 'SECTIONROW');
    template.addColumn("btnSecCol", "btnSecRow", null, "SECTIONCOL");
    template.addElement("searchButton", "btnSecCol", "BUTTON", null, "SEARCHBTN");
    template.addElement("addButton", "btnSecCol", "BUTTON", null, "ADDBTN");
    
    
    // Create Table
	
	if(lnoofifaces > 0) {
	    var lfirstifaceobj = datamodel.interfaces[0];
		lservicetyp = lfirstifaceobj.servicetype;
		template.addRow('TableRow', 'SearchGridCol', null, 'GRIDROW');
		template.addColumn('TableColumn', 'TableRow', null, 'GRIDCOL' );
		template.addPanel('tablePanel', 'TableColumn', 'SIMPLE', null, 'SIMPLEPANEL');
        template.addPanelSection("tablePanelSection", "tablePanel", null, "PANELSECTION");
		template.addContainer('Table1', 'tablePanelSection', 'TABLE', null, 'TABLE');

		for(var iface = 0; iface < lnoofifaces; iface++) {
		    lifaceobj = datamodel.interfaces[iface];
            var lnoofnodes = 0;
            var ldmlobj = {};
            var lnodeobj = {};
            var lnoofdmls = lifaceobj.dmls.length;
            //alert(lnoofdmls);
            for (var d = 0; d < lnoofdmls; d++) {
                ldmlobj = lifaceobj.dmls[d];
                if (ldmlobj.type == "REQUESTDATAMODEL" && ldmlobj.nodes != undefined) {
                    lnoofnodes = ldmlobj.nodes.length;
                    //alert(lnoofnodes);
                    for (var lnode = 0; lnode < lnoofnodes; lnode++) {
                        dmtype = "REQUESTDATAMODEL";
                        lnodeobj = ldmlobj.nodes[lnode];
                        createNodeWidgets(lnodeobj);
                    }
                }
            }
		}
	}
}

function createNodeWidgets(pnodeobj) {
    var lnoofelms = pnodeobj.elements.length;
	var lnodename = pnodeobj.name;
	if(lnoofelms > 0) {
	    lcount = lcount + 1;
	    var lcommonid = pnodeobj.name + "__" + lcount;
		var lgrid = "GR__" + lcommonid;
		var lgcid = "GC__" + lcommonid;
        var lpanel = "P__" + lcommonid;
        var lpanelsec = "PC__" + lcommonid;
	    var lcontainerId = "CON__" + lcommonid;
	    var lsrid = "SR__" + lcommonid;
    	var lscid = "SC__" + lcommonid;
    	main.pointers['Table1'].icon = 'icon-list-alt';
	    main.pointers['Table1'].title = 'Search Results';
	    main.pointers['Table1'].containerstate = "READONLY";
	   // main.pointers['Table1'].events[0]["function"] = 'apz.APZAPPID.fnLaunchViewScreen(event)';
	    //main.pointers['Table1'].events[0]["name"] = 'ONCLICK';
	    template.addRow(lsrid, 'Table1', null, "SECTIONROW");
    	template.addColumn(lscid, lsrid, null, "SECTIONCOL");
    	formseccol= [];
		for(var lelm = 0; lelm < lnoofelms; lelm++){
			var lelmobj = pnodeobj.elements[lelm];
			createElementWidgets(pnodeobj, lelmobj, lscid, false);
			if(lelmobj.properties.filterrequired === "Y") {
			    formlscid = 'form_' + lscid + lelm;
			    formseccol.push(formlscid);
			    template.addColumn(formlscid, 'formSecRow', null, "SECTIONCOL");
			    createElementWidgets(pnodeobj, lelmobj, formlscid, true);   
			}
		}
		if(formseccol.length > 0) {
		    formseccolwidth = (100/formseccol.length);
		    for(var fs = 0; fs < formseccol.length; fs++) {
		        main.pointers[formseccol[fs]].width = (formseccolwidth);
		    }
		}
	}
} 

function createElementWidgets(pnodeobj, pelement, ppid, isForm) {
    //alert('Alert' + JSON.stringify(lelmobj));
    var lelmname = pelement.name;
	//var lwidgettype = "INPUTBOX";
	var lnodename = pnodeobj.name;
	var lelmid = utils.getNameforWidget(lifaceobj.name,dmtype,lnodename,lelmname);
	if (dmtype == "Response") {
		if (container == "FORM") {
			lwidgettype = "INPUTBOX";
		} else {
